#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Opening()
		  PopupCountry.AddRow("FR - France")
		  PopupCountry.AddRow("DE - Germany")
		  PopupCountry.AddRow("IT - Italy")
		  PopupCountry.AddRow("ES - Spain")
		  PopupCountry.AddRow("BE - Belgium")
		  PopupCountry.AddRow("NL - Netherlands")
		  PopupCountry.AddRow("AT - Austria")
		  PopupCountry.AddRow("PT - Portugal")
		  PopupCountry.AddRow("LU - Luxembourg")
		  PopupCountry.AddRow("IE - Ireland")
		  PopupCountry.AddRow("FI - Finland")
		  PopupCountry.AddRow("GR - Greece")
		  PopupCountry.SelectedRowIndex = 0
		End Sub
	#tag EndEvent

	#tag Property, Flags = &h0
		Cancelled As Boolean = True
	#tag EndProperty

	#tag Property, Flags = &h0
		SelectedCountryCode As String
	#tag EndProperty


#tag EndWindowCode

#tag Events ButtonOK
	#tag Event
		Sub Pressed()
		  Var selectedItem As String = PopupCountry.SelectedRowText
		  SelectedCountryCode = selectedItem.Left(2)
		  Cancelled = False
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ButtonCancel
	#tag Event
		Sub Pressed()
		  SelectedCountryCode = ""
		  Cancelled = True
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
